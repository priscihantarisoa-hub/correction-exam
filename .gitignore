# Fichiers ignorés par Git

# Fichiers temporaires
*.class
*.log
*.tmp

# Répertoire de compilation
/build/
/target/

# IDE
.idea/
*.iml
.vscode/
.settings/
.project
.classpath

# OS
Thumbs.db
.DS_Store


# Voir l'état
git status

# Voir les changements
git diff

# Voir l'historique
git log

# Ajouter les modifications
git add .

# Sauvegarder (commit)
git commit -m "Description des changements"

# Créer une branche
git checkout -b nom_branche

# Basculer de branche
git checkout master
git checkout develop

